{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "gm-apprentice",
  "compatibility_date": "2026-11-18",
  "observability": { "enabled": true },
  // Redirects www and blog to the bare domain (worker/index.mjs); everything else is a static file.
  "main": "./worker/index.mjs",
  "workers_dev": true,
  "preview_urls": true,
  "routes": [
    { "pattern": "gmapprentice.com", "custom_domain": true },
    { "pattern": "www.gmapprentice.com", "custom_domain": true },
    { "pattern": "blog.gmapprentice.com", "custom_domain": true }
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true,
    "not_found_handling": "404-page"
  }
}
