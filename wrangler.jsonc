{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "gm-apprentice",
  "compatibility_date": "2026-11-18",
  "observability": { "enabled": true },
  "workers_dev": true,
  "preview_urls": true,
  "routes": [
    { "pattern": "gmapprentice.com", "custom_domain": true },
    { "pattern": "www.gmapprentice.com", "custom_domain": true }
  ],
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page"
  }
}
