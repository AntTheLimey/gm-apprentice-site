<script is:inline>
(function(){
  var links=[].slice.call(document.querySelectorAll('.cycle a'));
  var secs=links.map(function(a){return document.getElementById(a.dataset.s)});
  function upd(){
    var y=window.innerHeight*0.35, cur=null;
    secs.forEach(function(s,i){var r=s.getBoundingClientRect(); if(r.top<y && r.bottom>y) cur=i;});
    links.forEach(function(a,i){a.classList.toggle('on',i===cur)});
  }
  window.addEventListener('scroll',upd,{passive:true}); upd();
})();
</script>
