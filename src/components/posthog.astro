---
// PostHog web analytics, on the live site only: never on branch previews or `astro dev`.
// - The project key is PostHog's public one (phc_): it is meant to sit in page source.
// - Cookieless: no cookies, so no consent banner. PostHog counts visitors with a daily
//   server-side hash ("cookieless server hash mode" must be on in the project's settings).
// - The site's owner opens ?me=on once in each browser (?me=off undoes it). That browser
//   then keeps one local-storage flag, and its events carry internal_visitor: true, which
//   the project's internal-user filter leaves out. Nobody else's browser stores anything.
// - Events go through the site's own Worker at /raven (worker/index.mjs), so
//   ad-blockers that block PostHog's hosts don't drop them.
// - No session recordings.
// - The visitor's country comes from Cloudflare via the Worker (see below).
const enabled = process.env.PREVIEW !== '1' && !import.meta.env.DEV;
const config = {
  key: 'phc_xRKyLwsnksXZPAcdm4iEJTvGsEXN5weNTuWpnbaFrGBT',
  options: {
    api_host: '/raven',
    ui_host: 'https://us.posthog.com',
    defaults: '2026-08-30',
    cookieless_mode: 'always',
    disable_session_recording: true,
    capture_exceptions: { capture_unhandled_errors: true, capture_unhandled_rejections: true, capture_console_errors: false },
  },
};
---
{enabled && (
<script is:inline define:vars={{ config }}>
  !function(t,e){var o,n,p,r;e.__SV||(window.posthog=e,e._i=[],e.init=function(i,s,a){function g(t,e){var o=e.split('.');2==o.length&&(t=t[o[0]],e=o[1]),t[e]=function(){t.push([e].concat(Array.prototype.slice.call(arguments,0)))}}(p=t.createElement('script')).type='text/javascript',p.crossOrigin='anonymous',p.async=!0,p.src=s.api_host+'/static/array.js',(r=t.getElementsByTagName('script')[0]).parentNode.insertBefore(p,r);var u=e;for(void 0!==a?u=e[a]=[]:a='posthog',u.people=u.people||[],Object.defineProperty(u,'toString',{configurable:!0,enumerable:!0,writable:!0,value:function(t){var e='posthog';return'posthog'!==a&&(e+='.'+a),t||(e+=' (stub)'),e}}),Object.defineProperty(u.people,'toString',{configurable:!0,enumerable:!0,writable:!0,value:function(){return u.toString(1)+'.people (stub)'}}),o='capture identify alias people.set people.set_once set_config register register_once unregister opt_out_capturing has_opted_out_capturing opt_in_capturing reset isFeatureEnabled onFeatureFlags getFeatureFlag getFeatureFlagPayload reloadFeatureFlags group updateEarlyAccessFeatureEnrollment getEarlyAccessFeatures getActiveMatchingSurveys getSurveys getNextSurveyStep onSessionId'.split(' '),n=0;n<o.length;n++)g(u,o[n]);e._i.push([i,s,a])},e.__SV=1)}(document,window.posthog||[]);
  // The country comes from the Worker (/raven/where): PostHog can't find it in cookieless
  // mode. Start PostHog once it answers, or after a second without it.
  (function () {
    // The owner's "this is me" flag: ?me=on sets it, ?me=off clears it, then the
    // parameter is taken back out of the address.
    var me = false;
    try {
      var params = new URLSearchParams(location.search);
      var asked = params.get('me');
      if (asked === 'on') localStorage.setItem('gma-internal', '1');
      if (asked === 'off') localStorage.removeItem('gma-internal');
      if (asked !== null) {
        params.delete('me');
        var rest = params.toString();
        history.replaceState(null, '', location.pathname + (rest ? '?' + rest : '') + location.hash);
      }
      me = localStorage.getItem('gma-internal') === '1';
    } catch (e) {}

    var started = false;
    function start(country) {
      if (started) return;
      started = true;
      var name = country;
      if (country) {
        try { name = new Intl.DisplayNames(['en'], { type: 'region' }).of(country) || country; } catch (e) {}
      }
      if (country || me) {
        config.options.before_send = function (event) {
          if (event && event.properties) {
            if (country) {
              event.properties.$geoip_country_code = country;
              event.properties.$geoip_country_name = name;
            }
            if (me) event.properties.internal_visitor = true;
          }
          return event;
        };
      }
      posthog.init(config.key, config.options);
    }
    setTimeout(function () { start(null); }, 1000);
    fetch(config.options.api_host + '/where')
      .then(function (r) { return r.ok ? r.json() : {}; })
      .then(function (d) { start(d.country); }, function () { start(null); });
  })();

  // The clicks worth counting by name (autocapture records every click as well):
  // - install_line_copied / code_copied: a code block's copy button
  // - file_downloaded: the notes-pile zip and any other download
  // - outbound_click: any link off the site (GitHub, D&D Beyond, campaign sites)
  // - getting_started_path_selected: the front page's two doors and its setup link
  document.addEventListener('click', function (event) {
    var copy = event.target.closest('.expressive-code .copy button');
    if (copy) {
      var code = copy.dataset.code || '';
      posthog.capture(code.indexOf('INSTALL.md') !== -1 ? 'install_line_copied' : 'code_copied', { page: location.pathname });
      return;
    }
    var link = event.target.closest('a[href]');
    if (!link) return;
    if (link.dataset.analyticsStartPath) {
      posthog.capture('getting_started_path_selected', { start_path: link.dataset.analyticsStartPath });
      return;
    }
    var url = new URL(link.href, location.href);
    if (/\.(zip|pdf)$/i.test(url.pathname)) {
      posthog.capture('file_downloaded', { file: url.pathname, page: location.pathname });
    } else if (url.host !== location.host) {
      posthog.capture('outbound_click', { url: url.href, host: url.host, page: location.pathname });
    }
  });
</script>
)}
