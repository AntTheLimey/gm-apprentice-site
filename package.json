{
  "name": "gm-apprentice-site",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "test": "node --test 'scripts/*.test.mjs'",
    "check:posts": "node scripts/check-posts.mjs",
    "check:links": "node scripts/check-links.mjs dist",
    "check:drift": "node scripts/check-drift.mjs",
    "deploy": "npm run build && npm run check:links && wrangler deploy",
    "prebuild": "mkdir -p public/downloads && rm -f public/downloads/notes-pile.zip && cd examples && zip -qrX ../public/downloads/notes-pile.zip notes-pile -x '*.DS_Store'"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "7.3.10",
    "@astrojs/starlight": "0.43.1",
    "@fontsource/alegreya": "5.3.0",
    "@fontsource/alegreya-sans": "5.3.0",
    "astro": "7.4.13",
    "cheerio": "1.2.0",
    "gray-matter": "4.0.3",
    "starlight-blog": "0.30.2",
    "starlight-links-validator": "0.27.0",
    "wrangler": "4.165.0"
  }
}
